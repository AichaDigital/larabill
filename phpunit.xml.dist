<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.3/phpunit.xsd"
    backupGlobals="false"
    bootstrap="vendor/autoload.php"
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    executionOrder="random"
    failOnWarning="true"
    failOnRisky="true"
    failOnEmptyTestSuite="true"
    beStrictAboutOutputDuringTests="true"
    cacheDirectory=".phpunit.cache"
    backupStaticProperties="false"
>
    <testsuites>
        <testsuite name="AichaDigital Test Suite">
            <directory>tests</directory>
            <!-- Fork-based concurrency ITs: opt-in only (RUN_CONCURRENCY_IT=1 +
                 MySQL env), never loaded by the default CI run. Run on demand:
                 RUN_CONCURRENCY_IT=1 vendor/bin/pest tests/Concurrency -->
            <exclude>tests/Concurrency</exclude>
        </testsuite>
    </testsuites>
    <php>
        <!-- The suite does not fit in PHP's 128M default: in parallel a worker
             dies rendering PDFs, sequentially the arch test dies inside
             php-parser (AID-976). It is declared HERE, and not in a composer
             script, because paratest spawns each worker as its own PHP process:
             the worker reads this file, but never the parent's inline ini
             flags. Same posture as PHPStan, which already asks for 1G in its
             own script. -->
        <ini name="memory_limit" value="1G"/>
    </php>
    <logging>
        <junit outputFile="build/report.junit.xml"/>
    </logging>
    <source>
        <include>
            <directory suffix=".php">./src</directory>
        </include>
        <exclude>
            <!-- Exclude database migrations, seeders, and factories -->
            <directory>./src/database</directory>
            <!-- Exclude Blade templates -->
            <directory>./resources</directory>
            <!-- Exclude configuration files -->
            <directory>./src/config</directory>
            <!-- Exclude service provider (mostly boilerplate) -->
            <file>./src/LarabillServiceProvider.php</file>
            <!-- Exclude facade (mostly boilerplate) -->
            <file>./src/Facades/Larabill.php</file>
            <!-- Exclude main Larabill class (mostly boilerplate) -->
            <file>./src/Larabill.php</file>
        </exclude>
    </source>
</phpunit>
