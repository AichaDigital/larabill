parameters:
    level: 8
    paths:
        - src
        - tests/Types

    # Scan directories for class discovery (factories need to be known but not analyzed)
    scanDirectories:
        - src/Database/Factories

    # Exclude from analysis (contain env() calls, migrations, factories)
    excludePaths:
        - bootstrap/cache (?)
        - storage/* (?)
        - database/migrations/* (?)
        - database/factories/* (?)
        - src/Database/Factories/* (?)
        - config/* (?)
        - src/config/* (?)

    # Ignore env() calls in package config files (they get published to config/)
    ignoreErrors:
        -
            message: "#Called 'env' outside of the config directory#"
            path: src/config/*.php
        # Traits meant for package consumers (not used internally)
        -
            message: "#Trait .+ is used zero times and is not analysed#"
            path: src/Concerns/HasUserRelationships.php
        # Dynamic User model from config (ADR-003: User replaces Customer)
        # Properties like display_name, relationship_type, legal_entity_type_code are expected
        -
            message: "#Access to an undefined property Illuminate\\\\Database\\\\Eloquent\\\\Model::#"
            paths:
                - src/Models/Invoice.php
                - src/Services/InvoiceService.php
        -
            message: "#Access to an undefined property Illuminate\\\\Foundation\\\\Auth\\\\User::#"
            paths:
                - src/Services/Adapters/VerifactuAdapter.php
        # Nullsafe operator warnings - these are intentional for nullable relationships
        -
            identifier: nullsafe.neverNull
            paths:
                - src/Models/Invoice.php
                - src/Services/InvoiceService.php
                - src/Services/Adapters/VerifactuAdapter.php
        # Cache::remember()/rememberForever() are declared to take a Closure; our
        # generic wrappers keep the flexible public signature (callable(): T) and
        # correctly declare @return T. larastan cannot propagate T into the facade's
        # TCacheValue template through a `callable`. Tool limitation on the inner
        # call, not a real type hole — resolving it would require narrowing the
        # public API to \Closure.
        -
            identifier: argument.templateType
            path: src/Services/CacheService.php
        # T7 deprecated-shim layer (ADR-015 §5): the shim layer and the legacy
        # bridge USE the retired symbols by design — `BillingInterval` bridges
        # from them, the Article transitional signatures keep them, and the
        # cancel() shims dispatch the legacy event. These usages die with the
        # shims in 8.0. NOT baseline entries — curated, path-scoped, removed
        # with the shim removal.
        -
            identifier: classConstant.deprecatedEnum
            paths:
                - src/ValueObjects/BillingInterval.php
                - src/Models/Article.php
        -
            identifier: property.deprecatedEnum
            paths:
                - src/ValueObjects/BillingInterval.php
                - src/Models/Article.php
        -
            identifier: parameter.deprecatedEnum
            paths:
                - src/ValueObjects/BillingInterval.php
                - src/Models/Article.php
        -
            identifier: return.deprecatedEnum
            paths:
                - src/ValueObjects/BillingInterval.php
                - src/Models/Article.php
        # Package-internal callers of deprecated delegating paths that keep
        # working until the 8.0 shim removal (ADR-015 §5):
        #   - ProcessPendingCancellations (larabill:process-cancellations)
        #     still calls the subsumed processPendingCancellations();
        #   - RecurringBillingService still delegates scheduling through
        #     ArticleServiceStatus::calculateNextBillingDate().
        # Migrating both to the new-model entry points is part of the 8.0
        # removal, not of the shim slice.
        -
            identifier: method.deprecated
            paths:
                - src/Actions/ProcessPendingCancellations.php
                - src/Services/RecurringBillingService.php
        # The cancel() shim re-dispatches the legacy @api ServiceCancelled
        # event (including deferred materialisation) so existing listeners
        # keep receiving their cancellations — gate round 10 P1.
        -
            identifier: staticMethod.deprecatedClass
            path: src/Services/ServiceLifecycleService.php
        -
            identifier: staticMethod.deprecatedEnum
            path: src/Services/ServiceLifecycleService.php

    # Basic strict rules that are supported
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    checkDynamicProperties: true
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false

    # Laravel specific
    noUnnecessaryCollectionCall: true
    noUnnecessaryCollectionCallOnly: []
    noUnnecessaryCollectionCallExcept: []

    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
