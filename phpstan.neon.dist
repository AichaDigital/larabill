includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src

    # Scan directories for class discovery (factories need to be known but not analyzed)
    scanDirectories:
        - src/Database/Factories

    # Exclude from analysis (contain env() calls, migrations, factories)
    excludePaths:
        - bootstrap/cache (?)
        - storage/* (?)
        - database/migrations/* (?)
        - database/factories/* (?)
        - src/Database/Factories/* (?)
        - config/* (?)
        - src/config/* (?)

    # Ignore env() calls in package config files (they get published to config/)
    ignoreErrors:
        -
            message: "#Called 'env' outside of the config directory#"
            path: src/config/*.php
        # Traits meant for package consumers (not used internally)
        -
            message: "#Trait .+ is used zero times and is not analysed#"
            path: src/Concerns/HasUserRelationships.php
        # Dynamic User model from config (ADR-003: User replaces Customer)
        # Properties like display_name, relationship_type, legal_entity_type_code are expected
        -
            message: "#Access to an undefined property Illuminate\\\\Database\\\\Eloquent\\\\Model::#"
            paths:
                - src/Models/Invoice.php
                - src/Services/InvoiceService.php
                - src/Services/Validators/AeatInvoiceValidator.php
        -
            message: "#Access to an undefined property Illuminate\\\\Foundation\\\\Auth\\\\User::#"
            paths:
                - src/Services/Adapters/VerifactuAdapter.php
                - src/Services/Validators/AeatInvoiceValidator.php
        # Nullsafe operator warnings - these are intentional for nullable relationships
        -
            identifier: nullsafe.neverNull
            paths:
                - src/Models/Invoice.php
                - src/Services/InvoiceService.php
                - src/Services/Adapters/VerifactuAdapter.php

    # Basic strict rules that are supported
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    checkDynamicProperties: true
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false

    # Laravel specific
    noUnnecessaryCollectionCall: true
    noUnnecessaryCollectionCallOnly: []
    noUnnecessaryCollectionCallExcept: []

    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
