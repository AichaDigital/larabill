includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src

    # Exclude config directories (contain env() calls which are valid)
    excludePaths:
        - bootstrap/cache (?)
        - storage/* (?)
        - database/migrations/* (?)
        - config/* (?)
        - src/config/* (?)

    # Ignore env() calls in package config files (they get published to config/)
    ignoreErrors:
        -
            message: "#Called 'env' outside of the config directory#"
            path: src/config/*.php

    # Basic strict rules that are supported
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    checkDynamicProperties: true
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false

    # Laravel specific
    noUnnecessaryCollectionCall: true
    noUnnecessaryCollectionCallOnly: []
    noUnnecessaryCollectionCallExcept: []

    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
