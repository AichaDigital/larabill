parameters:
	ignoreErrors:
		-
			message: '#^Method AichaDigital\\Larabill\\Models\\Article\:\:getActiveOverrideFor\(\) should return AichaDigital\\Larabill\\Models\\ArticleOverride\|null but returns Illuminate\\Database\\Eloquent\\Model\|null\.$#'
			identifier: return.type
			count: 1
			path: src/Models/Article.php

		-
			message: '#^Cannot call method canBill\(\) on string\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Models/ArticleServiceStatus.php

		-
			message: '#^Method AichaDigital\\Larabill\\Models\\TaxGroup\:\:taxRates\(\) should return Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany\<AichaDigital\\Larabill\\Models\\TaxRate, Illuminate\\Database\\Eloquent\\Relations\\Pivot, ''pivot''\> but returns Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany\<AichaDigital\\Larabill\\Models\\TaxRate, \$this\(AichaDigital\\Larabill\\Models\\TaxGroup\), Illuminate\\Database\\Eloquent\\Relations\\Pivot, ''pivot''\>\.$#'
			identifier: return.type
			count: 1
			path: src/Models/TaxGroup.php

		-
			message: '#^PHPDoc type array\<string\> of property AichaDigital\\Larabill\\Models\\TaxGroup\:\:\$fillable is not covariant with PHPDoc type list\<string\> of overridden property Illuminate\\Database\\Eloquent\\Model\:\:\$fillable\.$#'
			identifier: property.phpDocType
			count: 1
			path: src/Models/TaxGroup.php

		-
			message: '#^Type string in generic type Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany\<AichaDigital\\Larabill\\Models\\TaxRate, Illuminate\\Database\\Eloquent\\Relations\\Pivot, string\> in PHPDoc tag @return is not subtype of template type TPivotModel of Illuminate\\Database\\Eloquent\\Relations\\Pivot \= Illuminate\\Database\\Eloquent\\Relations\\Pivot of class Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany\.$#'
			identifier: generics.notSubtype
			count: 1
			path: src/Models/TaxGroup.php

		-
			message: '#^Method AichaDigital\\Larabill\\Models\\TaxRate\:\:taxGroups\(\) should return Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany\<AichaDigital\\Larabill\\Models\\TaxGroup, Illuminate\\Database\\Eloquent\\Relations\\Pivot, ''pivot''\> but returns Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany\<AichaDigital\\Larabill\\Models\\TaxGroup, \$this\(AichaDigital\\Larabill\\Models\\TaxRate\), Illuminate\\Database\\Eloquent\\Relations\\Pivot, ''pivot''\>\.$#'
			identifier: return.type
			count: 1
			path: src/Models/TaxRate.php

		-
			message: '#^PHPDoc type array\<string\> of property AichaDigital\\Larabill\\Models\\TaxRate\:\:\$fillable is not covariant with PHPDoc type list\<string\> of overridden property Illuminate\\Database\\Eloquent\\Model\:\:\$fillable\.$#'
			identifier: property.phpDocType
			count: 1
			path: src/Models/TaxRate.php

		-
			message: '#^Type string in generic type Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany\<AichaDigital\\Larabill\\Models\\TaxGroup, Illuminate\\Database\\Eloquent\\Relations\\Pivot, string\> in PHPDoc tag @return is not subtype of template type TPivotModel of Illuminate\\Database\\Eloquent\\Relations\\Pivot \= Illuminate\\Database\\Eloquent\\Relations\\Pivot of class Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany\.$#'
			identifier: generics.notSubtype
			count: 1
			path: src/Models/TaxRate.php

		-
			message: '#^Method AichaDigital\\Larabill\\Services\\BillingService\:\:calculateSubtotal\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: src/Services/BillingService.php

		-
			message: '#^Property AichaDigital\\Larabill\\Services\\BillingService\:\:\$roiVerificationService is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Services/BillingService.php

		# Self-calls to deprecated methods (internal use until v0.7.0 refactor to InvoiceNumberingService)
		-
			message: '#^Call to deprecated method generateInvoiceNumber\(\) of class AichaDigital\\Larabill\\Services\\BillingService#'
			identifier: method.deprecated
			count: 1
			path: src/Services/BillingService.php

		-
			message: '#^Call to deprecated method getTempSeriesNumber\(\) of class AichaDigital\\Larabill\\Services\\BillingService#'
			identifier: method.deprecated
			count: 1
			path: src/Services/BillingService.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: src/Services/InvoiceService.php

		-
			message: '#^Parameter \#1 \$invoiceData of method AichaDigital\\Larabill\\Services\\InvoiceService\:\:createInvoice\(\) expects array\{customer_id\: int, items\: array\<array\{article_id\: int, quantity\: int, base_price\: float\}\>, type\?\: string, status\?\: string, due_date\?\: string\|null, payment_terms\?\: int\|null, template_name\?\: string\|null\}, array\{customer_id\: int\|null, items\: array\<mixed\>, type\: ''invoice'', status\: ''pending'', due_date\: Illuminate\\Support\\Carbon\|null, payment_terms\: string\|null, template_name\: string\|null\} given\.$#'
			identifier: argument.type
			count: 1
			path: src/Services/InvoiceService.php

		-
			message: '#^Access to an undefined property AichaDigital\\Larabill\\Models\\Invoice\:\:\$taxProfile\.$#'
			identifier: property.notFound
			count: 1
			path: src/Services/InvoiceVerifactuService.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\HasMany\:\:active\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Services/PricingService.php

		-
			message: '#^Using nullsafe property access "\?\-\>custom_price" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Services/PricingService.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$id\.$#'
			identifier: property.notFound
			count: 2
			path: src/Services/RecurringBillingService.php

		-
			message: '#^Parameter \#2 \$type of event class AichaDigital\\Larabill\\Events\\ServiceCancelled constructor expects AichaDigital\\Larabill\\Enums\\CancellationType in AichaDigital\\Larabill\\Events\\ServiceCancelled\:\:dispatch\(\), string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Services/ServiceLifecycleService.php
