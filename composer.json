{
    "name": "aichadigital/larabill",
    "description": "Professional billing & invoicing package for Laravel with UUID binary storage, VAT verification, EU compliance, and agnostic user models (UUID/ULID/Int)",
    "keywords": [
        "laravel",
        "billing",
        "invoicing",
        "vat",
        "tax",
        "fiscal",
        "uuid",
        "spain",
        "eu",
        "b2b",
        "reverse-charge",
        "larabill",
        "aichadigital"
    ],
    "homepage": "https://github.com/aichadigital/larabill",
    "license": "MIT",
    "authors": [
        {
            "name": "Abdelkarim Mateos Sanchez",
            "email": "abdelkarim.mateos@castris.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "aichadigital/lara100": "^1.0 || dev-main",
        "aichadigital/lararoi": "dev-main",
        "aichadigital/lara-verifactu": "^0.2.0 || dev-main",
        "dompdf/dompdf": "^3.1",
        "dyrynda/laravel-model-uuid": "^8.2",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "lorisleiva/laravel-actions": "^2.0",
        "spatie/laravel-package-tools": "^1.17"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.25",
        "matthewbdaly/artisan-standalone": "^0.0.12",
        "nunomaduro/collision": "^8.8",
        "nunomaduro/phpinsights": "^2.13",
        "orchestra/testbench": "^10.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AichaDigital\\Larabill\\": "src/",
            "AichaDigital\\Larabill\\Database\\Factories\\": "src/Database/Factories/",
            "AichaDigital\\Larabill\\Database\\Seeders\\": "src/Database/Seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AichaDigital\\Larabill\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "App\\": "tests/Models/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@composer run prepare"
        ],
        "post-update-cmd": [
            "@composer run prepare"
        ],
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-parallel": "vendor/bin/pest --parallel",
        "test-profile": "vendor/bin/pest --profile",
        "test-coverage": "vendor/bin/pest --coverage",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "phpstan-baseline": "vendor/bin/phpstan analyse --generate-baseline --memory-limit=1G",
        "phpinsights": "vendor/bin/phpinsights",
        "phpinsights-fix": "vendor/bin/phpinsights fix",
        "phpinsights-baseline": "vendor/bin/phpinsights baseline",
        "quality": [
            "@format",
            "@phpstan",
            "@test-coverage"
        ],
        "quality-full": [
            "@format",
            "@phpstan",
            "@test-coverage",
            "@test-mutate"
        ],
        "precommit": [
            "@format",
            "@phpstan",
            "@test-parallel"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AichaDigital\\Larabill\\LarabillServiceProvider"
            ],
            "aliases": {
                "Larabill": "AichaDigital\\Larabill\\Facades\\Larabill"
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-refactor/agnostic": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
