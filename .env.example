APP_NAME=Larabill
APP_ENV=local
APP_KEY=base64:your-app-key-here
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

# Larabill VAT API Configuration
LARABILL_ABSTRACTAPI_KEY=your_abstractapi_key_here
LARABILL_APILAYER_KEY=your_apilayer_key_here

# Larabill Company Configuration
LARABILL_COMPANY_NAME=Your Company S.L.
LARABILL_COMPANY_VAT=ESB12345678
LARABILL_COMPANY_COUNTRY=ES
LARABILL_COMPANY_IS_ROI=true