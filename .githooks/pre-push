#!/bin/sh

# Pre-push hook for Larabill
# Ensures code quality before pushing to remote

echo "🔍 Running pre-push checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_success() {
    echo "${GREEN}✓ $1${NC}"
}

print_error() {
    echo "${RED}✗ $1${NC}"
}

print_info() {
    echo "${YELLOW}ℹ $1${NC}"
}

# Check if vendor directory exists
if [ ! -d "vendor" ]; then
    print_error "Vendor directory not found. Run 'composer install' first."
    exit 1
fi

# 1. Code Style (Laravel Pint)
print_info "Running Laravel Pint (code style)..."
composer format --quiet
if [ $? -ne 0 ]; then
    print_error "Code style check failed. Run 'composer format' to fix issues."
    exit 1
fi
print_success "Code style check passed"

# 2. Static Analysis (PHPStan)
print_info "Running PHPStan (static analysis)..."
composer phpstan --quiet
if [ $? -ne 0 ]; then
    print_error "PHPStan analysis failed. Fix the issues before pushing."
    exit 1
fi
print_success "PHPStan analysis passed"

# 3. Tests
print_info "Running tests..."
composer test --quiet
if [ $? -ne 0 ]; then
    print_error "Tests failed. Fix failing tests before pushing."
    exit 1
fi
print_success "All tests passed"

# All checks passed
echo ""
print_success "All pre-push checks passed! 🚀"
echo ""

exit 0
